# ── 大模型（必填）────────────────────────────────
# 阿里云百炼控制台获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 向量检索 ────────────────────────────────────
EMBED_MODEL=text-embedding-v3
CHROMA_DIR=./data/chroma
COLLECTION=ops_runbook
RETRIEVAL_TOP_K=4

# ── 会话存储 ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
HISTORY_ROUNDS=6
SESSION_TTL=21600

# ── 命令执行安全 ────────────────────────────────
# 只做演示、不让 Agent 真的碰机器时改成 false
ALLOW_EXECUTE=true
CMD_TIMEOUT=10
MAX_OUTPUT_CHARS=4000

# ── Agent ──────────────────────────────────────
# 图的最大步数（1 轮工具调用 = agent + tools 两步）
RECURSION_LIMIT=40
# 单轮对话的工具轮数预算，用完强制收尾作答
MAX_TOOL_ROUNDS=6
# 单条消息里允许并行发起的工具调用数
MAX_CALLS_PER_ROUND=6
